OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: the model that checks CV reviews (LLM-as-a-judge). Empty = same as OPENAI_MODEL.
# JUDGE_MODEL=gpt-4o
# Which websites may call this API. "*" = everyone (fine for local dev).
# In production put your frontend URL, e.g. https://career-coach.vercel.app
ALLOWED_ORIGINS=*
